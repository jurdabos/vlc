[Unit]
Description=VLC Data Pipeline Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{VLC_ROOT}}/compose
ExecStart={{VLC_ROOT}}/scripts/vlc-start.sh
ExecStop={{VLC_ROOT}}/scripts/vlc-stop.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
