          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  fiwareid,\n  ts,\n  pm25,\n  pm10,\n  CASE\n    WHEN pm25 IS NULL AND pm10 IS NULL THEN 'No PM Data'\n    WHEN COALESCE(pm25, 0) <= 12 AND COALESCE(pm10, 0) <= 54 THEN 'Good'\n    WHEN COALESCE(pm25, 0) <= 35.4 OR COALESCE(pm10, 0) <= 154 THEN 'Moderate'\n    WHEN COALESCE(pm25, 0) <= 55.4 OR COALESCE(pm10, 0) <= 254 THEN 'Unhealthy for Sensitive Groups'\n    WHEN COALESCE(pm25, 0) <= 150.4 OR COALESCE(pm10, 0) <= 354 THEN 'Unhealthy'\n    WHEN COALESCE(pm25, 0) <= 250.4 OR COALESCE(pm10, 0) <= 424 THEN 'Very Unhealthy'\n    ELSE 'Hazardous'\n  END AS aqi_category,\n  lat,\n  lon\nFROM air.latest;",
          "refId": "A",
