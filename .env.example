VLC_DEV_PASSWORD="very-long-password-that-you-should-set-up-not-me"
GF_SECURITY_ADMIN_USER=vlc_dev
PGPASSWORD=${VLC_DEV_PASSWORD}

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_1=vlc.air
KAFKA_TOPIC_2=vlc.weather

# Polling
POLL_EVERY_SECONDS=300
PAGE_LIMIT=100

# Dual bases
VLC_EXPLORE_BASE=https://valencia.opendatasoft.com/api/explore/v2.1
VLC_EXPLORE_BASE2=https://valencia.opendatasoft.com/api/v2
VLC_DATASET_ID_1=estacions-contaminacio-atmosferiques-estaciones-contaminacion-atmosfericas
VLC_DATASET_ID_2=estacions-atmosferiques-estaciones-atmosfericas

# Offset persistence - Using project-relative path for Windows
STATE_DIR=./state
START_OFFSET=1970-01-01T00:00:00Z
PG_BOOTSTRAP=false

# Timescale
PGHOST=timescaledb
PGPORT=5432
PGDATABASE=vlc
PGUSER=postgres

# Incremental ingestion controls
TIMESTAMP_FIELD=fecha_carg
AUTO_TS_FIELD=true

# SMTP for Alertmanager notifications
SMTP_HOST=<fill-it-in-with-superb-data>
SMTP_PORT=<fill-it-in-with-superb-data>
SMTP_FROM=<fill-it-in-with-superb-data>
SMTP_USER=<fill-it-in-with-superb-data>
SMTP_PASSWORD=<fill-it-in-with-superb-data>