VLC_DEV_PASSWORD="very-long-password-that-you-should-set-up-not-me"
GF_SECURITY_ADMIN_USER=vlc_dev
PGPASSWORD=${VLC_DEV_PASSWORD}

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_1=vlc.air
KAFKA_TOPIC_2=vlc.weather

# Polling
POLL_EVERY_SECONDS=300
# ArcGIS layer maxRecordCount is 2000; the layers we ingest hold ~11 (air) and ~5 (weather) features.
PAGE_LIMIT=2000

# Upstream source: Valencia geoportal ArcGIS REST.
# Air pollution stations live on layer 156, weather stations on layer 157.
# Layer IDs are set per producer service in compose/docker-compose.yml.
VLC_ARCGIS_BASE=https://geoportal.valencia.es/server/rest/services/OPENDATA/MedioAmbiente/MapServer

# Surface a louder warning every N consecutive empty poll cycles
# (default 12 ≈ one hour at the 5-minute cadence above).
VLC_STALE_WARN_EVERY=12

# Offset persistence - Using project-relative path for Windows
STATE_DIR=./state
START_OFFSET=1970-01-01T00:00:00Z
PG_BOOTSTRAP=false

# Timescale
PGHOST=timescaledb
PGPORT=5432
PGDATABASE=vlc
PGUSER=postgres

# Incremental ingestion controls
TIMESTAMP_FIELD=fecha_carg
AUTO_TS_FIELD=true

# SMTP for Alertmanager notifications (optional - only needed if using email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
